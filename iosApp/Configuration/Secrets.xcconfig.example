// Copy to Secrets.xcconfig (git-ignored) and fill in.
// xcconfig treats "//" as a comment, so write the URL with "$()" between the slashes.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
// The *publishable* (anon) key only. The build fails if a secret / service-role key is used.
SUPABASE_ANON_KEY = sb_publishable_xxxxxxxxxxxxxxxx
// Your Apple developer team ID, for device builds.
HV_DEVELOPMENT_TEAM = ABCDE12345
