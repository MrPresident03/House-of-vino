<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy decision (ADR-09): the cellar database and photos are excluded from Google cloud backup
  and device-to-device transfer. Backup is the user's choice: Supabase sync or CSV export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
